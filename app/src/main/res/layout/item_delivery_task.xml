<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp" app:cardElevation="3dp"
    app:strokeColor="@color/border_color" app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_delivery_item"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 kWh Solar"
                android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_delivery_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                android:text="AVAILABLE"
                android:textColor="@color/green_badge_text"
                android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="10dp" android:background="@color/border_color" />

        <TextView android:id="@+id/tv_pickup_location"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📍 PICKUP: —" android:textColor="@color/text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/tv_drop_location"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🏠 DROP: —" android:textColor="@color/text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/tv_distance_km"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🛣️ Distance: 0 km"
            android:textColor="@color/text_secondary" android:textSize="12sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="10dp" android:background="@color/border_color" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_delivery_partner_cut"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Earning: ₹0.00"
                    android:textColor="@color/emerald_primary_dark"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_delivery_fee_total"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Total Fee: ₹0.00"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_delivery"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="Accept Delivery"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- R2-10.1: Mark Picked Up (after ACCEPTED) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_picked_up"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/emerald_primary"
            android:text="Mark Order Picked Up"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="10dp" />

        <!-- R2-10.2: Code entry only after picked up -->
        <LinearLayout android:id="@+id/layout_code_verification"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Enter 6-Digit Code from Buyer"
                app:boxStrokeColor="@color/emerald_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_delivery_code_input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mark_delivered"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="Mark Delivered"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>