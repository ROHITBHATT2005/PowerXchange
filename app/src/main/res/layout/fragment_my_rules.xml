<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/emerald_super_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Auto-Buy Rules"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Automatically buy new listings under your price thresholds"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_auto_rules"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />

                <TextView android:id="@+id/tv_empty_rules"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:text="No rules yet. Add one below."
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_rule"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/emerald_primary"
                    android:text="+ Add Rule"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_schedule_worker"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Enable Background Engine (15 min)"
                    android:textAllCaps="false"
                    android:textColor="@color/emerald_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/emerald_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Auto-Buy History"
            android:textColor="@color/text_primary"
            android:textSize="17sp" android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_auto_history"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView android:id="@+id/tv_empty_history"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="No auto-buy activity yet."
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>