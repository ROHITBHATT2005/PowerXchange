<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <TextView android:id="@+id/tv_order_item"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 kWh Solar"
                android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" />

            <TextView android:id="@+id/tv_order_amount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="@color/emerald_primary_dark"
                android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tv_order_seller"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Seller: —"
            android:textColor="@color/text_secondary" android:textSize="13sp" />

        <TextView android:id="@+id/tv_order_buyer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Buyer: —"
            android:textColor="@color/text_secondary" android:textSize="13sp" />

        <TextView android:id="@+id/tv_order_partner"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Partner: Not assigned"
            android:textColor="@color/text_secondary" android:textSize="12sp" />

        <TextView android:id="@+id/tv_order_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="@color/text_secondary" android:textSize="12sp" />

        <TextView android:id="@+id/tv_order_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PLACED"
            android:textColor="@color/emerald_primary"
            android:textStyle="bold" android:textSize="13sp" />

        <!-- Status tracker steps -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="6dp" android:orientation="horizontal">
            <View android:id="@+id/step1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginEnd="2dp" android:layout_weight="1"
                android:background="#DADADA" />
            <View android:id="@+id/step2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp" android:layout_weight="1"
                android:background="#DADADA" />
            <View android:id="@+id/step3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp" android:layout_weight="1"
                android:background="#DADADA" />
            <View android:id="@+id/step4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="2dp" android:layout_weight="1"
                android:background="#DADADA" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border_color" />

        <!-- Code (buyer only) -->
        <LinearLayout android:id="@+id/layout_order_code"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Delivery Handover Code:"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
                <TextView android:id="@+id/tv_order_delivery_code"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.2"
                    android:text="000000"
                    android:textColor="@color/emerald_primary"
                    android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_code"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:paddingHorizontal="12dp"
                android:text="Copy Code"
                android:textColor="@color/emerald_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/emerald_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>