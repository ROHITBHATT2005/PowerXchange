<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_green"
                android:padding="10dp">
                <ImageView android:id="@+id/iv_pool_icon"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_solar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/tv_pool_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Solar Pool by Creator"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" />

                <TextView android:id="@+id/tv_pool_price_rate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Solar • ₹2.34/kWh"
                    android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>

            <TextView android:id="@+id/tv_pool_status_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                android:text="OPEN"
                android:textColor="@color/green_badge_text"
                android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="10dp" android:background="@color/border_color" />

        <TextView android:id="@+id/tv_pool_location"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Seller • Location"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/tv_pool_kwh_progress"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 / 0 kWh (Remaining: 0)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pool_pct"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/emerald_primary"
                    android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_pool"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:progress="0"
                app:indicatorColor="@color/emerald_primary"
                app:trackColor="@color/emerald_light"
                app:trackCornerRadius="4dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_join_pool"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:backgroundTint="@color/emerald_primary"
                android:paddingHorizontal="20dp"
                android:text="Join Pool"
                android:textSize="13sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>